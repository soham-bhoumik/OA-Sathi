# OA-Sathi Configuration (Optional Local Edge Services)
# -----------------------------------------------------
# Note: OA-Sathi is an offline-first, client-side application.
# Questionnaires, MediaPipe pose tracking, and screening evaluations run
# directly in the browser with local persistence.
#
# If running the optional local Python/FastAPI gait analysis service,
# set its local address below:
VITE_GAIT_BACKEND_URL=http://127.0.0.1:8000
